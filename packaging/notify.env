# Admin notifications about new requests. This file holds credentials: it must
# keep mode 0600 and belong to the hauswart user, or the server will not use it.
# Restart hauswart-server after changing it.
#
# ntfy. The topic works like a password, so choose a long random one.
#NTFY_URL=https://ntfy.example.org/a-long-random-topic
#NTFY_TOKEN=tk_...
#
# Email. SMTP_TLS is starttls (default, port 587), tls (port 465) or none.
#SMTP_HOST=mail.example.org
#SMTP_PORT=587
#SMTP_TLS=starttls
#SMTP_USER=hauswart@example.org
#SMTP_PASSWORD=...
#SMTP_FROM=Hauswart <hauswart@example.org>
#SMTP_TO=admin@example.org, second-admin@example.org
