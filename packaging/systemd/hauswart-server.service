[Unit]
Description=Hauswart management server
After=network-online.target
Wants=network-online.target
# The VPN may come up after this service. Keep retrying until the address
# exists instead of giving up after a few attempts.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/hauswart/server.env
ExecStart=/usr/bin/hauswart-server -data ${STATE_DIRECTORY} $HAUSWART_ARGS
Restart=on-failure
RestartSec=5

# The server needs no privileges: it only serves a port and writes its state.
User=hauswart
Group=hauswart
StateDirectory=hauswart-server
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
